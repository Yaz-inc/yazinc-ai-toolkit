</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🔧 Cache Clear Script</h1>
            <p>Laravel Application</p>
        </div>
        
        <div class="content">
            <div class="warning">
                <strong>⚠️ Security Notice:</strong>
                Delete this file after use or restrict access via .htaccess for production environments.
            </div>
            
            <?php foreach ($results as $stepKey => $step): ?>
                <div class="step">
                    <div class="step-header">
                        <?php echo htmlspecialchars($step['title']); ?>
                    </div>
                    <div class="step-body">
                        <?php foreach ($step['items'] as $item): ?>
                            <div class="item <?php echo $item['success'] ? 'success' : 'error'; ?>">
                                <span class="icon"><?php echo $item['success'] ? '✓' : '✗'; ?></span>
                                <span>
                                    <strong><?php echo htmlspecialchars($item['description']); ?>:</strong>
                                    <?php 
                                    if (isset($item['message'])) {
                                        echo htmlspecialchars($item['message']);
                                    } else {
                                        echo $item['success'] ? 'Completed successfully' : 'Failed';
                                        if (!empty($item['output'])) {
                                            echo '<br><small style="opacity: 0.7;">' . nl2br(htmlspecialchars($item['output'])) . '</small>';
                                        }
                                    }
                                    ?>
                                </span>
                            </div>
                        <?php endforeach; ?>
                    </div>
                </div>
            <?php endforeach; ?>
            
            <?php if (!empty($errorMessages)): ?>
                <div class="error-list">
                    <strong>⚠️ Errors Encountered:</strong>
                    <ul>
                        <?php foreach ($errorMessages as $error): ?>
                            <li><?php echo htmlspecialchars($error); ?></li>
                        <?php endforeach; ?>
                    </ul>
                </div>
            <?php endif; ?>
            
            <div class="summary">
                <h2><?php echo $hasErrors ? '⚠️ Completed with Errors' : '✅ All Caches Cleared Successfully'; ?></h2>
                <p>
                    <?php if ($hasErrors): ?>
                        Some operations encountered errors. Please review the details above.
                    <?php else: ?>
                        All caches have been cleared. Your application is now refreshed and ready to use.
                    <?php endif; ?>
                </p>
            </div>
            
            <div class="timestamp">
                Executed on: <?php echo date('Y-m-d H:i:s T'); ?><br>
                IP Address: <?php echo htmlspecialchars($clientIp); ?>
            </div>
        </div>
    </div>
</body>
