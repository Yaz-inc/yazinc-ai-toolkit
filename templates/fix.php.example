            flex-shrink: 0;
        }
        
        .summary {
            background: <?php echo $hasErrors ? '#fef2f2' : '#f0fdf4'; ?>;
            border: 2px solid <?php echo $hasErrors ? '#ef4444' : '#10b981'; ?>;
            border-radius: 8px;
            padding: 20px;
            margin-top: 30px;
            text-align: center;
        }
        
        .summary h2 {
