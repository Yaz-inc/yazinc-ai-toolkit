# --- Deploy secrets block (deploy-secrets-zero-exposure skill) ---
# Append to project .gitignore — adjust paths per stack

.env
.env.backup
.env.production
.env.local
.env.*.local

# Local deploy keys & ops (NEVER on production web root)
/_deploy/
key.*.md
*github_pat*
*.pem
*.key
id_rsa*

# Laravel ops & runtime secrets
/public/fix.php
/storage/app/ai/settings.json
_server_env

# Logs & dumps (can contain queries, paths, tokens)
*.log
/storage/logs/
*.sql
*.sql.gz
backup/
*.zip

# IDE / OS noise
.DS_Store
Thumbs.db
